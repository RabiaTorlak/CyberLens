SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Cursor SDK (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# auto | cursor | heuristic  (auto: Cursor varsa SDK, yoksa heuristic)
AI_ANALYSIS_MODE=auto

# Logging
LOG_LEVEL=INFO

# Required only for scripts/apply_schema.py (Database password from Supabase Dashboard)
SUPABASE_DB_PASSWORD=
# Or provide a full connection string instead:
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
