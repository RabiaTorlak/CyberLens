SUPABASE_URL=https://your-project.supabase.co
# Varsayılan lab şemasında anon (publishable) anahtar yeterlidir.
# supabase/hardening/rls_lockdown.sql uygulandıysa service_role anahtarı gerekir;
# bu anahtar tüm verilere tam erişim verir, yalnızca sunucu tarafındaki .env'de tutun.
SUPABASE_KEY=your-anon-key

# Cursor SDK (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# auto | cursor | heuristic  (auto: Cursor varsa SDK, yoksa heuristic)
AI_ANALYSIS_MODE=auto

# Threat Intelligence (opsiyonel) — çoklu kaynak.
# Boş bırakılırsa yerleşik bilinen-zararlı listesi + sezgisel kontrol kullanılır.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
# Ağırlıklı risk skoru kaynak ağırlıkları (opsiyonel, toplam ~1.0)
TI_WEIGHT_VT=0.45
TI_WEIGHT_ABUSE=0.35
TI_WEIGHT_OTX=0.20

# Logging
LOG_LEVEL=INFO

# Required only for scripts/apply_schema.py (Database password from Supabase Dashboard)
SUPABASE_DB_PASSWORD=
# Or provide a full connection string instead:
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
